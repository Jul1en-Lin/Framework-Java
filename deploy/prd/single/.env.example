# Copy to .env and fill locally. Never commit the filled file.
# Use single quotes for values containing $, # or spaces (Compose dotenv syntax).
MYSQL_ROOT_PASSWORD=
MYSQL_APP_USER=
MYSQL_APP_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=
RABBITMQ_PASSWORD=
# Server signing key: base64 encoding of at least 32 random bytes.
NACOS_AUTH_TOKEN=
NACOS_AUTH_IDENTITY_KEY=
NACOS_AUTH_IDENTITY_VALUE=
# Client login, NOT the server signing key. Must match the existing Nacos account.
NACOS_USERNAME=
NACOS_PASSWORD=
WEB_PORT=8666
